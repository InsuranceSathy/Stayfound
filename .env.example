# Copy to .env.local and fill in. Never commit real values.

# --- database ---
DATABASE_URL=

# --- auth (Better Auth + Google) ---
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- scoring (GLM / z.ai) ---
GLM_API_KEY=
GLM_MODEL=

# --- billing (Dodo Payments) ---
# StayFound.tech is a SECONDARY BRAND under the NumberHill Dodo business, so the
# API key and webhook secret are the business's, while every product id below
# must be a product created under the StayFound brand.
#
# Test and live are separate worlds: flipping DODO_ENVIRONMENT means replacing
# the API key, the webhook secret AND all six product ids. Defaults to `test`.
DODO_ENVIRONMENT=test
DODO_API_KEY=
# Signing secret from Dodo → Settings → Webhooks, for the endpoint pointed at
# https://<your-domain>/api/billing/webhook
# Subscribe: subscription.active, subscription.renewed, subscription.on_hold,
# subscription.paused, subscription.plan_changed, subscription.cancelled,
# subscription.expired, subscription.failed
DODO_WEBHOOK_SECRET=

# The StayFound.tech brand, so `npm run dodo:check` can prove every product
# below belongs to it. Dodo has no brand field on a checkout session — a
# checkout is branded by its *product*, and a product created without an
# explicit brand silently defaults to the primary brand (NumberHill).
DODO_BRAND_ID=

# One Dodo product per (plan, billing period), each created UNDER THE STAYFOUND
# BRAND. Prices must match lib/plans.ts: monthly $29 / $149 / $499.
DODO_PRODUCT_SOLO_MONTHLY=
DODO_PRODUCT_TEAMS_MONTHLY=
DODO_PRODUCT_AGENCIES_MONTHLY=

# Yearly is optional — the pricing page hides the monthly/yearly toggle until
# ALL THREE exist, so a partial set does nothing. Price them at 10x monthly
# ($290 / $1490 / $4990) to match the "two months free" claim in lib/plans.ts.
DODO_PRODUCT_SOLO_YEARLY=
DODO_PRODUCT_TEAMS_YEARLY=
DODO_PRODUCT_AGENCIES_YEARLY=

# Set to 1 to sell the plans. While unset, the pricing CTAs book a waitlist
# spot, the dashboard Billing panel is hidden, and /api/billing/checkout refuses
# to open a session. Inlined at build time — changing it needs a rebuild.
NEXT_PUBLIC_BILLING_CHECKOUT_ENABLED=

# Fallback origin for the checkout return url when the request origin is
# unavailable. Also used by the sitemap.
NEXT_PUBLIC_SITE_URL=https://www.stayfound.tech

# --- referral / affiliate program (all optional; unset = program hidden) ---
# Attribution, affiliate signup and the earnings report live in an external
# affiliate platform (Endorsely). Dodo has no affiliate features of its own —
# it carries the referral id as payment metadata and nothing more.

# Where an affiliate signs up and checks their balance, on the vendor's domain.
# Unset hides the /refer page (404) and the dashboard's Refer & earn panel.
# Inlined at build time — changing it needs a rebuild.
NEXT_PUBLIC_REFERRAL_PORTAL_URL=

# Endorsely organisation id. Loads the tracking script that populates
# `window.endorsely_referral`; unset means no script and no attribution.
# Inlined at build time — changing it needs a rebuild.
NEXT_PUBLIC_ENDORSELY_ORG_ID=

# Endorsely API secret, for reporting conversions from the Dodo webhook.
# Server-only: it is a bearer token for writing commissions.
ENDORSELY_API_SECRET=

# The key the referral id travels under in Dodo payment metadata. Ours to
# choose; the webhook reads it back off the event to report the conversion.
# Changing it orphans referrals already in flight on open checkouts.
REFERRAL_METADATA_KEY=endorsely_referral

# --- lead notifications (all optional; leads are always logged) ---
# Slack or Discord incoming webhook
LEAD_WEBHOOK_URL=
# Email via Resend — needs both key and recipients
RESEND_API_KEY=
LEAD_NOTIFY_TO=
LEAD_NOTIFY_FROM=
