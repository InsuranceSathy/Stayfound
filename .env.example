# Copy to .env.local and fill in. Never commit real values.

# --- database ---
DATABASE_URL=

# --- auth (Better Auth + Google) ---
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- scoring (GLM / z.ai) ---
