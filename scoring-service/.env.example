# Surfaced scoring service

# Must match SCORING_SECRET in the main app's env.
SCORING_SECRET=

# Port to listen on (default 8787).
PORT=8787

# Ollama (local, free) — used for auxiliary reasoning + as a local engine.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:14b-instruct
# Set to 0 to NOT use the local model as an engine perspective.
OLLAMA_ENGINE=1
OLLAMA_ENGINE_LABEL=Local (Ollama)

# Number of buyer prompts to sample per engine (default 6).
SCORING_PROMPTS=6

# Optional cloud engine — add a Google AI Studio key to query real Gemini.
# GOOGLE_GENERATIVE_AI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash

# GLM (Zhipu / z.ai) — OpenAI-compatible. Set the key to enable.
# To replace Ollama with GLM entirely: set OLLAMA_ENGINE=0 and add:
# GLM_API_KEY=
# GLM_BASE_URL=https://api.z.ai/api/paas/v4
# GLM_MODEL=glm-4.6
# GLM_ENGINE_LABEL=GLM
